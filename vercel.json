{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/docs",
      "destination": "/api"
    },
    {
      "source": "/redoc",
      "destination": "/api"
    },
    {
      "source": "/openapi.json",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/((?!api|docs|redoc|openapi.json|health).*)",
      "destination": "/index.html"
    }
  ]
}
